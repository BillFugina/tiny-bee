# Copy to .env for local dev. Never commit .env (it's gitignored).

# Postgres connection string.
#   Local:  postgres://postgres:postgres@localhost:5432/tinybee
#   Neon:   postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
# On Vercel, the Neon integration sets this per environment (and per preview branch).
DATABASE_URL=

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Optional. Public origin of the app. Defaults to the Vercel deployment URL,
# or http://localhost:5173 locally.
# BETTER_AUTH_URL=http://localhost:5173

# Optional. Switches on each member's private check-in with the planner agent.
# Without it the chat shows as off. Get a key from the Claude Console.
# ANTHROPIC_API_KEY=
# Optional overrides for the planner (defaults: claude-haiku-5-5, low).
# PLANNER_MODEL=claude-haiku-5-5
# PLANNER_EFFORT=low
